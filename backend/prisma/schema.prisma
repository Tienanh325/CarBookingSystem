generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum DriverVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverOnlineStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum VehicleRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RideStatus {
  SCHEDULED
  REQUESTED
  SEARCHING_DRIVER
  ACCEPTED
  DRIVER_ARRIVING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_DRIVER
  CANCELLED_BY_SYSTEM
  NO_DRIVER_FOUND
}

enum DriverOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  VIETQR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WalletTransactionType {
  RIDE_EARNING
  COMMISSION
  CASH_COLLECTION
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum CustomerWalletTransactionType {
  TOP_UP
  RIDE_PAYMENT
  REFUND
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SurchargeType {
  PEAK_HOUR
  LATE_NIGHT
  WEATHER
  CUSTOM
}

enum WeatherCondition {
  NORMAL
  RAIN
  HEAVY_RAIN
  FLOOD
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  phone        String     @unique
  email        String?    @unique
  passwordHash String?    @map("password_hash")
  fullName     String     @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles           UserRole[]
  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  addresses       Address[]
  rides           Ride[]           @relation("CustomerRides")
  statusLogs      RideStatusLog[]  @relation("RideStatusChangedBy")
  ratingsGiven    Rating[]         @relation("RatingsGiven")
  ratingsReceived Rating[]         @relation("RatingsReceived")
  supportTickets  SupportTicket[]  @relation("CustomerTickets")
  assignedTickets SupportTicket[]  @relation("AssignedTickets")
  notifications   Notification[]
  auditLogs       AuditLog[]
  promotionUsages PromotionUsage[]
  payments        Payment[]
  sessions        AuthSession[]
  customerWallet  CustomerWallet?
  walletTopUps    WalletTopUp[]

  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  ratingAvg Decimal  @default(5.0) @map("rating_avg") @db.Decimal(3, 2)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DriverProfile {
  id                 String                   @id @default(uuid()) @db.Char(36)
  userId             String                   @unique @map("user_id") @db.Char(36)
  licenseNumber      String?                  @map("license_number")
  identityNumber     String?                  @map("identity_number")
  verificationStatus DriverVerificationStatus @default(PENDING) @map("verification_status")
  onlineStatus       DriverOnlineStatus       @default(OFFLINE) @map("online_status")
  ratingAvg          Decimal                  @default(5.0) @map("rating_avg") @db.Decimal(3, 2)
  totalRides         Int                      @default(0) @map("total_rides")
  approvedAt         DateTime?                @map("approved_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles    Vehicle[]
  documents   DriverDocument[]
  rides       Ride[]
  location    DriverLocation?
  wallet      DriverWallet?
  withdrawals WithdrawalRequest[]
  tickets     SupportTicket[]     @relation("DriverTickets")
  rejections  RideRejection[]
  offers      DriverOffer[]

  @@index([onlineStatus, verificationStatus])
  @@map("driver_profiles")
}

model VehicleType {
  id            String   @id @default(uuid()) @db.Char(36)
  code          String   @unique
  name          String
  capacity      Int
  baseFare      Decimal  @map("base_fare") @db.Decimal(12, 2)
  perKmFare     Decimal  @map("per_km_fare") @db.Decimal(12, 2)
  perMinuteFare Decimal  @map("per_minute_fare") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicles       Vehicle[]
  rides          Ride[]
  pricingRules   PricingRule[]
  surchargeRules SurchargeRule[]

  @@map("vehicle_types")
}

model Vehicle {
  id                 String                    @id @default(uuid()) @db.Char(36)
  driverId           String                    @map("driver_id") @db.Char(36)
  vehicleTypeId      String                    @map("vehicle_type_id") @db.Char(36)
  plateNumber        String                    @unique @map("plate_number")
  brand              String?
  model              String?
  color              String?
  registrationStatus VehicleRegistrationStatus @default(PENDING) @map("registration_status")
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  driver      DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleType VehicleType   @relation(fields: [vehicleTypeId], references: [id])

  @@index([driverId, isActive])
  @@index([vehicleTypeId])
  @@map("vehicles")
}

model DriverDocument {
  id         String    @id @default(uuid()) @db.Char(36)
  driverId   String    @map("driver_id") @db.Char(36)
  type       String
  fileUrl    String    @map("file_url")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_documents")
}

model Address {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  label     String
  address   String
  lat       Decimal  @db.Decimal(10, 7)
  lng       Decimal  @db.Decimal(10, 7)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Ride {
  id                   String        @id @default(uuid()) @db.Char(36)
  customerId           String        @map("customer_id") @db.Char(36)
  driverId             String?       @map("driver_id") @db.Char(36)
  vehicleTypeId        String        @map("vehicle_type_id") @db.Char(36)
  pickupAddress        String        @map("pickup_address")
  pickupLat            Decimal       @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng            Decimal       @map("pickup_lng") @db.Decimal(10, 7)
  dropoffAddress       String        @map("dropoff_address")
  dropoffLat           Decimal       @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng           Decimal       @map("dropoff_lng") @db.Decimal(10, 7)
  estimatedDistanceKm  Decimal?      @map("estimated_distance_km") @db.Decimal(10, 2)
  estimatedDurationMin Int?          @map("estimated_duration_min")
  estimatedFare        Decimal?      @map("estimated_fare") @db.Decimal(12, 2)
  stopFee              Decimal       @default(0) @map("stop_fee") @db.Decimal(12, 2)
  surchargeAmount      Decimal       @default(0) @map("surcharge_amount") @db.Decimal(12, 2)
  surchargeBreakdown   Json?         @map("surcharge_breakdown")
  commissionRate       Decimal       @default(0.2) @map("commission_rate") @db.Decimal(5, 4)
  finalFare            Decimal?      @map("final_fare") @db.Decimal(12, 2)
  promotionId          String?       @map("promotion_id") @db.Char(36)
  paymentMethod        PaymentMethod @default(CASH) @map("payment_method")
  status               RideStatus    @default(REQUESTED)
  scheduledAt          DateTime?     @map("scheduled_at")
  matchingStartedAt    DateTime?     @map("matching_started_at")
  routeGeometry        Json?         @map("route_geometry")
  routeProvider        String?       @map("route_provider")
  requestedAt          DateTime      @default(now()) @map("requested_at")
  acceptedAt           DateTime?     @map("accepted_at")
  arrivedAt            DateTime?     @map("arrived_at")
  startedAt            DateTime?     @map("started_at")
  completedAt          DateTime?     @map("completed_at")
  cancelledAt          DateTime?     @map("cancelled_at")
  cancelReason         String?       @map("cancel_reason")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  customer           User                @relation("CustomerRides", fields: [customerId], references: [id])
  driver             DriverProfile?      @relation(fields: [driverId], references: [id])
  vehicleType        VehicleType         @relation(fields: [vehicleTypeId], references: [id])
  promotion          Promotion?          @relation(fields: [promotionId], references: [id])
  statusLogs         RideStatusLog[]
  payment            Payment?
  rating             Rating?
  supportTickets     SupportTicket[]
  walletTransactions WalletTransaction[]
  promotionUsages    PromotionUsage[]
  rejections         RideRejection[]
  stops              RideStop[]
  offers             DriverOffer[]

  @@index([customerId, requestedAt])
  @@index([driverId, requestedAt])
  @@index([status, requestedAt])
  @@map("rides")
}

model RideStop {
  id           String   @id @default(uuid()) @db.Char(36)
  rideId       String   @map("ride_id") @db.Char(36)
  orderIndex   Int      @map("order_index")
  address      String
  lat          Decimal  @db.Decimal(10, 7)
  lng          Decimal  @db.Decimal(10, 7)
  dwellMinutes Int      @default(5) @map("dwell_minutes")
  fee          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, orderIndex])
  @@map("ride_stops")
}

model DriverOffer {
  id               String            @id @default(uuid()) @db.Char(36)
  rideId           String            @map("ride_id") @db.Char(36)
  driverId         String            @map("driver_id") @db.Char(36)
  radiusKm         Decimal           @map("radius_km") @db.Decimal(5, 2)
  pickupDistanceKm Decimal           @map("pickup_distance_km") @db.Decimal(8, 2)
  status           DriverOfferStatus @default(PENDING)
  expiresAt        DateTime          @map("expires_at")
  respondedAt      DateTime?         @map("responded_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  ride   Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverId])
  @@index([driverId, status, expiresAt])
  @@index([rideId, status])
  @@map("driver_offers")
}

model RideStatusLog {
  id          String      @id @default(uuid()) @db.Char(36)
  rideId      String      @map("ride_id") @db.Char(36)
  fromStatus  RideStatus? @map("from_status")
  toStatus    RideStatus  @map("to_status")
  note        String?
  changedById String?     @map("changed_by_id") @db.Char(36)
  createdAt   DateTime    @default(now()) @map("created_at")

  ride      Ride  @relation(fields: [rideId], references: [id], onDelete: Cascade)
  changedBy User? @relation("RideStatusChangedBy", fields: [changedById], references: [id])

  @@index([rideId, createdAt])
  @@map("ride_status_logs")
}

model DriverLocation {
  id        String   @id @default(uuid()) @db.Char(36)
  driverId  String   @unique @map("driver_id") @db.Char(36)
  lat       Decimal  @db.Decimal(10, 7)
  lng       Decimal  @db.Decimal(10, 7)
  heading   Decimal? @db.Decimal(6, 2)
  speed     Decimal? @db.Decimal(6, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_locations")
}

model PricingRule {
  id                  String    @id @default(uuid()) @db.Char(36)
  vehicleTypeId       String    @map("vehicle_type_id") @db.Char(36)
  baseFare            Decimal   @map("base_fare") @db.Decimal(12, 2)
  perKmFare           Decimal   @map("per_km_fare") @db.Decimal(12, 2)
  perMinuteFare       Decimal   @map("per_minute_fare") @db.Decimal(12, 2)
  minimumFare         Decimal   @map("minimum_fare") @db.Decimal(12, 2)
  waitingFeePerMinute Decimal   @default(0) @map("waiting_fee_per_minute") @db.Decimal(12, 2)
  peakMultiplier      Decimal   @default(1.0) @map("peak_multiplier") @db.Decimal(4, 2)
  activeFrom          DateTime  @default(now()) @map("active_from")
  activeTo            DateTime? @map("active_to")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@index([vehicleTypeId, isActive])
  @@map("pricing_rules")
}

model SurchargeRule {
  id                String        @id @default(uuid()) @db.Char(36)
  vehicleTypeId     String?       @map("vehicle_type_id") @db.Char(36)
  name              String
  type              SurchargeType
  multiplier        Decimal       @default(1.0) @db.Decimal(5, 2)
  fixedAmount       Decimal       @default(0) @map("fixed_amount") @db.Decimal(12, 2)
  startMinute       Int?          @map("start_minute")
  endMinute         Int?          @map("end_minute")
  daysOfWeek        String?       @map("days_of_week") @db.VarChar(20)
  weatherConditions String?       @map("weather_conditions") @db.VarChar(100)
  activeFrom        DateTime      @default(now()) @map("active_from")
  activeTo          DateTime?     @map("active_to")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id])

  @@index([vehicleTypeId, isActive])
  @@index([type, isActive])
  @@map("surcharge_rules")
}

model PricingContext {
  id               String           @id @default("GLOBAL") @db.VarChar(20)
  weatherCondition WeatherCondition @default(NORMAL) @map("weather_condition")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("pricing_contexts")
}

model Promotion {
  id           String        @id @default(uuid()) @db.Char(36)
  code         String        @unique
  name         String
  type         PromotionType
  value        Decimal       @db.Decimal(12, 2)
  maxDiscount  Decimal?      @map("max_discount") @db.Decimal(12, 2)
  minRideFare  Decimal?      @map("min_ride_fare") @db.Decimal(12, 2)
  usageLimit   Int?          @map("usage_limit")
  perUserLimit Int?          @map("per_user_limit")
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  rides  Ride[]
  usages PromotionUsage[]

  @@map("promotions")
}

model PromotionUsage {
  id          String   @id @default(uuid()) @db.Char(36)
  promotionId String   @map("promotion_id") @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  rideId      String?  @map("ride_id") @db.Char(36)
  discount    Decimal  @db.Decimal(12, 2)
  usedAt      DateTime @default(now()) @map("used_at")

  promotion Promotion @relation(fields: [promotionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  ride      Ride?     @relation(fields: [rideId], references: [id])

  @@index([promotionId, userId])
  @@map("promotion_usages")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Char(36)
  rideId                String        @unique @map("ride_id") @db.Char(36)
  customerId            String        @map("customer_id") @db.Char(36)
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod
  provider              String?
  providerTransactionId String?       @map("provider_transaction_id")
  paymentReference      String?       @unique @map("payment_reference") @db.VarChar(50)
  expiresAt             DateTime?     @map("expires_at")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  ride     Ride @relation(fields: [rideId], references: [id])
  customer User @relation(fields: [customerId], references: [id])

  @@index([status, createdAt])
  @@map("payments")
}

model CustomerWallet {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("VND")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CustomerWalletTransaction[]

  @@map("customer_wallets")
}

model CustomerWalletTransaction {
  id          String                        @id @default(uuid()) @db.Char(36)
  walletId    String                        @map("wallet_id") @db.Char(36)
  rideId      String?                       @map("ride_id") @db.Char(36)
  topUpId     String?                       @map("top_up_id") @db.Char(36)
  amount      Decimal                       @db.Decimal(12, 2)
  type        CustomerWalletTransactionType
  status      WalletTransactionStatus       @default(COMPLETED)
  description String?
  createdAt   DateTime                      @default(now()) @map("created_at")

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  topUp  WalletTopUp?   @relation(fields: [topUpId], references: [id])

  @@index([walletId, createdAt])
  @@index([rideId])
  @@map("customer_wallet_transactions")
}

model WalletTopUp {
  id                    String        @id @default(uuid()) @db.Char(36)
  customerId            String        @map("customer_id") @db.Char(36)
  amount                Decimal       @db.Decimal(12, 2)
  paymentReference      String        @unique @map("payment_reference") @db.VarChar(50)
  providerTransactionId String?       @map("provider_transaction_id")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?     @map("paid_at")
  expiresAt             DateTime      @map("expires_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  customer     User                        @relation(fields: [customerId], references: [id])
  transactions CustomerWalletTransaction[]

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@map("wallet_top_ups")
}

model PaymentWebhookEvent {
  id                    String   @id @default(uuid()) @db.Char(36)
  provider              String
  providerTransactionId String   @unique @map("provider_transaction_id")
  paymentReference      String   @map("payment_reference") @db.VarChar(50)
  amount                Decimal  @db.Decimal(12, 2)
  payload               Json?
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("payment_webhook_events")
}

model DriverWallet {
  id             String   @id @default(uuid()) @db.Char(36)
  driverId       String   @unique @map("driver_id") @db.Char(36)
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  pendingBalance Decimal  @default(0) @map("pending_balance") @db.Decimal(12, 2)
  currency       String   @default("VND")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  driver       DriverProfile       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("driver_wallets")
}

model WalletTransaction {
  id          String                  @id @default(uuid()) @db.Char(36)
  walletId    String                  @map("wallet_id") @db.Char(36)
  rideId      String?                 @map("ride_id") @db.Char(36)
  amount      Decimal                 @db.Decimal(12, 2)
  type        WalletTransactionType
  status      WalletTransactionStatus @default(COMPLETED)
  description String?
  createdAt   DateTime                @default(now()) @map("created_at")

  wallet DriverWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  ride   Ride?        @relation(fields: [rideId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id              String           @id @default(uuid()) @db.Char(36)
  driverId        String           @map("driver_id") @db.Char(36)
  amount          Decimal          @db.Decimal(12, 2)
  bankCode        String           @map("bank_code") @db.VarChar(30)
  accountNumber   String           @map("account_number") @db.VarChar(50)
  accountName     String           @map("account_name") @db.VarChar(150)
  status          WithdrawalStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason")
  reviewedById    String?          @map("reviewed_by_id") @db.Char(36)
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

model Rating {
  id         String   @id @default(uuid()) @db.Char(36)
  rideId     String   @unique @map("ride_id") @db.Char(36)
  fromUserId String   @map("from_user_id") @db.Char(36)
  toUserId   String   @map("to_user_id") @db.Char(36)
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  ride     Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  fromUser User @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("RatingsReceived", fields: [toUserId], references: [id])

  @@map("ratings")
}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Char(36)
  ticketNo     String         @unique @map("ticket_no")
  rideId       String?        @map("ride_id") @db.Char(36)
  customerId   String?        @map("customer_id") @db.Char(36)
  driverId     String?        @map("driver_id") @db.Char(36)
  assignedToId String?        @map("assigned_to_id") @db.Char(36)
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  resolution   String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  ride       Ride?          @relation(fields: [rideId], references: [id])
  customer   User?          @relation("CustomerTickets", fields: [customerId], references: [id])
  driver     DriverProfile? @relation("DriverTickets", fields: [driverId], references: [id])
  assignedTo User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])

  @@index([status, priority])
  @@map("support_tickets")
}

model Notification {
  id        String              @id @default(uuid()) @db.Char(36)
  userId    String              @map("user_id") @db.Char(36)
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  data      Json?
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model AuthSession {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @db.Char(36)
  refreshHash String   @db.Char(64)
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model RideRejection {
  rideId   String        @db.Char(36)
  driverId String        @db.Char(36)
  ride     Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver   DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([rideId, driverId])
  @@map("ride_rejections")
}
