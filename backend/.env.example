NODE_ENV=development
PORT=4000
APP_NAME="Ride Booking Backend"
APP_ORIGIN=http://localhost:5173
API_RATE_LIMIT=600

DATABASE_URL="mysql://ride_booking:ride_booking@localhost:3306/ride_booking"
REDIS_URL="redis://localhost:6379"
METRICS_TOKEN="replace-with-monitoring-token"
ALERT_WEBHOOK_URL=""

JWT_ACCESS_SECRET="change-this-access-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PASSWORD_RESET_TTL_MINUTES=15
# HTTPS endpoint called with { userId, phone, email, resetToken, expiresAt }.
PASSWORD_RESET_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_TOKEN=""
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@example.com"
PHONE_MASKING_SECRET="replace-with-at-least-32-random-characters"
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="ap-southeast-1"
OBJECT_STORAGE_BUCKET="goride-documents"
OBJECT_STORAGE_ACCESS_KEY="goride"
OBJECT_STORAGE_SECRET_KEY="replace-this-minio-password"
OBJECT_STORAGE_FORCE_PATH_STYLE=true

OTP_EXPIRES_MINUTES=5
DEFAULT_ADMIN_PHONE="0900000000"
DEFAULT_ADMIN_PASSWORD="Admin@123456"

# OSRM works without a key. Set MAPBOX_ACCESS_TOKEN to automatically use
# Mapbox driving-traffic for live/historical traffic-aware ETA.
ROUTING_BASE_URL="https://router.project-osrm.org"
ROUTING_API_TOKEN=""
MAPBOX_ACCESS_TOKEN=""

# Photon supports search-as-you-type. For production, point this to a private
# Photon instance or another provider with an appropriate SLA.
GEOCODING_BASE_URL="https://photon.komoot.io"
GEOCODING_API_TOKEN=""

MATCHING_OFFER_SECONDS=20
SCHEDULE_MATCH_LEAD_MINUTES=30
MATCHING_MAX_WAIT_SECONDS=180
# Drivers whose last GPS update is older than this are excluded from matching.
DRIVER_LOCATION_MAX_AGE_SECONDS=120
WAITING_GRACE_MINUTES=5
CANCEL_FEE_AFTER_ACCEPT=10000
CANCEL_FEE_AFTER_ARRIVED=20000
RIDE_START_PIN_SECRET="change-this-ride-start-pin-secret"

# Fintech / VietQR. IPN signature = HMAC-SHA256(secret,
# "transactionId|reference|amount|paidAt").
PLATFORM_COMMISSION_RATE=0.20
VIETQR_BANK_BIN="970422"
VIETQR_ACCOUNT_NUMBER="0000000000"
VIETQR_ACCOUNT_NAME="GORIDE"
VIETQR_TEMPLATE="compact2"
# In production this must be an SLA-backed QR rendering endpoint compatible
# with /{bankBin}-{accountNumber}-{template}.png query parameters.
VIETQR_QR_BASE_URL="https://img.vietqr.io/image"
VIETQR_WEBHOOK_SECRET="change-this-vietqr-webhook-secret"
VIETQR_PAYMENT_TTL_MINUTES=15
VIETQR_RECONCILIATION_URL=""
VIETQR_RECONCILIATION_TOKEN=""
RECONCILIATION_INTERVAL_MINUTES=15
RECONCILIATION_LOOKBACK_HOURS=48
